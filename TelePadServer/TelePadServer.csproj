<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TelePadServer</AssemblyName>
    <RootNamespace>TelePadServer</RootNamespace>
    
    <!-- Assembly Metadata -->
    <Title>TelePad Server</Title>
    <Product>TelePad - Wireless Controller Relay &amp; Virtual Gamepad Hub</Product>
    <Company>i7Exceed</Company>
    <Authors>i7Exceed</Authors>
    <Copyright>Copyright © 2026 i7Exceed. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>High-performance Windows input server for TelePad client over low-latency UDP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

</Project>
